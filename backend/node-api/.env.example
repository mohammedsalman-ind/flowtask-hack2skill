# Node API Environment Variables
# Copy this file to .env and fill in your values.

PORT=4000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google OAuth (for Calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ML API
ML_API_URL=http://127.0.0.1:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Supabase email confirmation redirect for web registrations through this API.
# Must be listed in Supabase Auth > URL Configuration > Additional Redirect URLs.
AUTH_EMAIL_REDIRECT_TO=http://localhost:5173/login

# Development convenience: create email accounts as confirmed so local signup/login works immediately. Set false in production.
AUTH_AUTO_CONFIRM_EMAIL=true

# User-scoped Supabase operations should use the anon key so RLS is enforced.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional outbound email. Keep the provider disabled until configured locally.
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=your-resend-api-key
SENDGRID_API_KEY=your-sendgrid-api-key
# Shared server-only secret. Set the same random value in the ML API environment.
ORG_AI_SHARED_SECRET=
