# FlowTask mobile environment
# For a physical Android development build connected with ADB reverse, the API defaults already work.
# Copy this file to .env only when you need to override the defaults or configure Supabase OAuth/password reset.

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
# Optional legacy direct ML endpoint; current mobile code routes AI through the Node API.
EXPO_PUBLIC_ML_API_BASE_URL=http://127.0.0.1:8000

# Required for Google OAuth and password reset. Email/password login itself goes through the Node API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_AUTH_REDIRECT_URL=flowtask://auth/callback
