{
  "expo": {
    "name": "FlowTask",
    "slug": "flowtask",
    "scheme": "flowtask",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.flowtask.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      "expo-font",
      "expo-asset",
      ["expo-notifications", { "icon": "./assets/icon.png" }],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow FlowTask to use your microphone.",
          "speechRecognitionPermission": "Allow FlowTask to understand your voice.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5f51d37f-a264-4c01-9adf-5674daa45ef2"
      }
    }
  }
}
